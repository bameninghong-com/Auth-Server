# ==============================================================================
# AUTH SERVER — Environment Variables
# cp .env.example .env  →  dann echte Werte eintragen
# NEVER commit .env to git
# ==============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=           # openssl rand -base64 32

# ── JWT ────────────────────────────────────────────────────────────────────────
# Ein Secret für alle Tenants — min. 64 Zeichen
# Generieren: openssl rand -base64 64
JWT_SECRET=

# ── pgAdmin (dev profile only) ─────────────────────────────────────────────────
PGADMIN_EMAIL=admin@localhost
PGADMIN_PASSWORD=admin
